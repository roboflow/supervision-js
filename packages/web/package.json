{
  "name": "supervision",
  "version": "0.1.2",
  "description": "Browser-native computer vision media rendering and annotation engine.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roboflow/supervision-js.git"
  },
  "homepage": "https://github.com/roboflow/supervision-js#readme",
  "bugs": {
    "url": "https://github.com/roboflow/supervision-js/issues"
  },
  "keywords": [
    "computer-vision",
    "annotations",
    "video",
    "rendering",
    "pixijs",
    "mediabunny",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./editing": {
      "types": "./dist/editing.d.ts",
      "import": "./dist/editing.js"
    },
    "./render-preparation-worker": "./dist/mask-preparation.worker.js"
  },
  "imports": {
    "#editing/*": {
      "types": "./dist/editing/*.d.ts",
      "import": "./dist/editing/*.js"
    },
    "#constants/*": {
      "types": "./dist/constants/*.d.ts",
      "import": "./dist/constants/*.js"
    },
    "#detections/*": {
      "types": "./dist/detections/*.d.ts",
      "import": "./dist/detections/*.js"
    },
    "#media/*": {
      "types": "./dist/media/*.d.ts",
      "import": "./dist/media/*.js"
    },
    "#playback/*": {
      "types": "./dist/playback/*.d.ts",
      "import": "./dist/playback/*.js"
    },
    "#render-preparation/*": {
      "types": "./dist/render-preparation/*.d.ts",
      "import": "./dist/render-preparation/*.js"
    },
    "#renderers/*": {
      "types": "./dist/renderers/*.d.ts",
      "import": "./dist/renderers/*.js"
    },
    "#sessions/*": {
      "types": "./dist/sessions/*.d.ts",
      "import": "./dist/sessions/*.js"
    },
    "#types/*": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/types/*.js"
    },
    "#workers/*": {
      "types": "./dist/workers/*.d.ts",
      "import": "./dist/workers/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && npm run build:types && npm run build:js",
    "build:js": "rollup -c",
    "build:types": "tsc --emitDeclarationOnly -p tsconfig.json",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "dev": "rollup -c -w",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "mediabunny": "^1.52.3",
    "pixi.js": "^8.19.0",
    "supervision-js-core": "file:../core"
  }
}
