{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@roboflow/video-engine": [
        "../../../roboflow-video-runtime/app/dist/videoEngineTypes/index.d.ts"
      ],
      "@roboflow/video-engine/analysis": [
        "../../../roboflow-video-runtime/app/dist/videoEngineTypes/analysis.d.ts"
      ],
      "#constants/*": ["src/constants/*"],
      "#detections/*": ["src/detections/*"],
      "#editing/*": ["src/editing/*"],
      "#media/*": ["src/media/*"],
      "#playback/*": ["src/playback/*"],
      "#render-preparation/*": ["src/render-preparation/*"],
      "#renderers/*": ["src/renderers/*"],
      "#sessions/*": ["src/sessions/*"],
      "#types/*": ["src/types/*"],
      "#workers/*": ["src/workers/*"]
    },
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "ignoreDeprecations": "6.0",
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
