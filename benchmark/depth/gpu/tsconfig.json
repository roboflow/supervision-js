{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "#constants/*": ["./../../../packages/web/src/constants/*"],
      "#detections/*": ["./../../../packages/web/src/detections/*"],
      "#media/*": ["./../../../packages/web/src/media/*"],
      "#render-preparation/*": [
        "./../../../packages/web/src/render-preparation/*"
      ],
      "#renderers/*": ["./../../../packages/web/src/renderers/*"],
      "#types/*": ["./../../../packages/web/src/types/*"],
      "#workers/*": ["./../../../packages/web/src/workers/*"]
    },
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["src"]
}
