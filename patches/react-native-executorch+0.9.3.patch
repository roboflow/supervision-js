 cv::Mat applySigmoid(const cv::Mat &logits) {
+#ifdef __ANDROID__
+  // Scalar fallback only where the SIMD kernel is unsafe; only correct for
+  // the CV_32FC1 logits this pipeline uses.
+  if (isRunningOnEmulator() && logits.type() == CV_32FC1) {
+    cv::Mat probMat(logits.rows, logits.cols, CV_8UC1);
+    for (int row = 0; row < logits.rows; ++row) {
+      const float *in = logits.ptr<float>(row);
+      uint8_t *out = probMat.ptr<uint8_t>(row);
+      for (int col = 0; col < logits.cols; ++col) {
+        out[col] =
+            static_cast<uint8_t>(255.0f / (1.0f + std::exp(-in[col])));
+      }
+    }
+    return probMat;
+  }
+#endif
