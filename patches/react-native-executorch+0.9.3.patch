+#ifdef __ANDROID__
+#include <sys/system_properties.h>
+namespace {
+// Local workaround (supervision-js bring-up): cv::exp's dispatched SIMD
+// kernel raises SIGILL on the Android emulator running on Apple Silicon.
+// Physical devices keep the fast vectorized path.
+bool isRunningOnEmulator() {
+  static const bool cached = [] {
+    char value[PROP_VALUE_MAX] = {0};
+    __system_property_get("ro.kernel.qemu", value);
+    return value[0] == '1';
+  }();
+  return cached;
+}
+} // namespace
+#endif
