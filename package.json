{
  "name": "supervision-js",
  "version": "0.0.0",
  "description": "Private prototype for browser-native computer vision rendering.",
  "private": true,
  "workspaces": [
    "benchmark/initial",
    "demo"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "imports": {
    "#constants/*": {
      "types": "./dist/constants/*.d.ts",
      "import": "./dist/constants/*.js"
    },
    "#detections/*": {
      "types": "./dist/detections/*.d.ts",
      "import": "./dist/detections/*.js"
    },
    "#media/*": {
      "types": "./dist/media/*.d.ts",
      "import": "./dist/media/*.js"
    },
    "#playback/*": {
      "types": "./dist/playback/*.d.ts",
      "import": "./dist/playback/*.js"
    },
    "#render-preparation/*": {
      "types": "./dist/render-preparation/*.d.ts",
      "import": "./dist/render-preparation/*.js"
    },
    "#renderers/*": {
      "types": "./dist/renderers/*.d.ts",
      "import": "./dist/renderers/*.js"
    },
    "#sessions/*": {
      "types": "./dist/sessions/*.d.ts",
      "import": "./dist/sessions/*.js"
    },
    "#styles/*": {
      "types": "./dist/styles/*.d.ts",
      "import": "./dist/styles/*.js"
    },
    "#types/*": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/types/*.js"
    },
    "#utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && npm run build:types && npm run build:js",
    "build:js": "rollup -c",
    "build:types": "tsc --emitDeclarationOnly -p tsconfig.json",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "dev": "npm run build && concurrently -k -n lib,demo -c cyan,magenta \"npm run dev:lib\" \"npm run dev:demo\"",
    "dev:lib": "rollup -c -w",
    "dev:demo": "npm run dev -w demo",
    "demo:dev": "npm run build && npm run dev:demo",
    "demo:build": "npm run build && npm run build -w demo",
    "benchmark:initial:dev": "npm run dev -w benchmark/initial",
    "benchmark:initial:build": "npm run build -w benchmark/initial",
    "fixture:sam3:dev": "npm run build && vite --config tools/sam3-fixture/vite.config.ts",
    "fixture:sam3:build": "npm run build && tsc --noEmit -p tools/sam3-fixture/tsconfig.json && vite build --config tools/sam3-fixture/vite.config.ts",
    "fixture:sam3:chunk": "node tools/sam3-fixture/chunk-detections.mjs",
    "fixture:sam3:extract": "node tools/sam3-fixture/extract-frames.mjs",
    "fixture:sam3:run": "node tools/sam3-fixture/run-sam3.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run demo:build && npm run benchmark:initial:build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,html,css}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "rollup": "^4.60.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "mediabunny": "^1.43.1",
    "pixi.js": "^8.18.1"
  }
}
