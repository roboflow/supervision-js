{
  "name": "supervision-js-react-native-example",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --offline --clear",
    "dev:client": "expo start --offline --clear --dev-client",
    "dev:client:ios": "expo start --offline --clear --dev-client --ios",
    "dev:client:android": "expo start --offline --clear --dev-client --android",
    "dev:client:tunnel": "expo start --clear --dev-client --tunnel",
    "ios:pods": "cd ios && pod install",
    "ios:patch": "node scripts/patch-expo-xcode-project.mjs",
    "ios:prepare": "npm run ios:pods && npm run ios:patch",
    "ios:build": "npm run ios:prepare && expo run:ios --no-install",
    "android:build": "expo run:android",
    "ios": "expo start --offline --clear --ios",
    "android": "expo start --offline --clear --android",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@shopify/react-native-skia": "2.6.2",
    "expo": "^57.0.11",
    "expo-asset": "^57.0.9",
    "expo-build-properties": "^57.0.9",
    "expo-dev-client": "^57.0.10",
    "expo-file-system": "^57.0.2",
    "expo-image-picker": "~57.0.8",
    "expo-status-bar": "^57.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "^0.86.2",
    "react-native-executorch": "^0.9.3",
    "react-native-executorch-expo-resource-fetcher": "^0.9.1",
    "react-native-nitro-image": "^0.15.1",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-reanimated": "4.5.1",
    "react-native-vision-camera": "^5.2.2",
    "react-native-vision-camera-worklets": "^5.2.2",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.10.1",
    "react-reconciler": "0.33.0",
    "supervision-js-core": "file:../../packages/core",
    "supervision-js-react-native": "file:../../packages/react-native"
  },
  "devDependencies": {
    "@expo/metro-runtime": "^57.0.8",
    "@types/react": "^19.2.18"
  },
  "codegenConfig": {
    "name": "SupervisionReactNativeExampleSpec",
    "type": "modules",
    "jsSrcsDir": "./src/codegen",
    "ios": {
      "modulesProvider": {
        "ETInstaller": "ETInstaller"
      }
    }
  }
}
